# ── OpenAI (all AI steps) ─────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Supabase (server-only; never NEXT_PUBLIC) — briefs, projects, prices, media
# This file's values are PRODUCTION. Local development reads
# .env.development.local instead (see README → Local database).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth (required) — signs the session cookie ───────────────────────────────
# openssl rand -base64 32. Missing => nobody can sign in, by design: auth that
# degrades to "allow" is worse than auth that is down.
AUTH_SECRET=
# Set during a rotation only: verified against, never signed with.
AUTH_SECRET_PREVIOUS=

# ── Maker notification (optional; dormant when unset) ────────────────────────
RESEND_API_KEY=
RESEND_FROM=softclose <brief@yourdomain.hr>
MAKER_NOTIFY_EMAIL=maker@example.com

# ── Optional: absolute app origin for links in emails (defaults to request origin)
APP_URL=

# ── Dev / ops ────────────────────────────────────────────────────────────────
# MOCK_AI=1 NEXT_PUBLIC_MOCK_AI=1   → canned AI responses (npm run dev:mock)
# RENDER_CAP_PER_SESSION=5          → per-session render cap (also NEXT_PUBLIC_…)
# VERCEL_TOKEN / VERCEL_BYPASS_SECRET → Claude's deploy checks (local only)
# FIRECRAWL_API_KEY                 → legacy Schachermayer scrape
